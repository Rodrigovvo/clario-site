# Cache de longa duracao para fontes locais imutaveis (1 ano)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Cache para favicon e imagens da identidade visual (1 mes)
/favicon*
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/marca/*
  Cache-Control: public, max-age=2592000

# Documentos HTML com revalidacao imediata para garantir frescor
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate
